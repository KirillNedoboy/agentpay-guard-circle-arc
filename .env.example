# No secrets are required for the MVP.

# Optional app config
APP_ENV=development
AGENTPAY_AUDIT_LOG_PATH=data/audit-log.jsonl
AGENTPAY_OBSERVATION_LOG_PATH=data/evaluation-observations.jsonl
# I3 execution state store (single-use execution claims); default: <dir of audit log>/execution-store
AGENTPAY_EXECUTION_STORE_PATH=data/execution-store/
